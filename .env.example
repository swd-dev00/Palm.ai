# Copy to /etc/palm/palm.env on the deployment host. Do not commit that file.
NODE_ENV=production
PORT=3000

# MySQL database. Use a dedicated least-privilege account and a strong password.
DATABASE_URL=mysql://palm:replace-with-a-strong-password@127.0.0.1:3306/palm_ai

# Generate each value with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
GITHUB_ACTIONS_RUNNER_SHARED_SECRET=replace-with-a-separate-long-random-secret

# GitHub Actions dispatcher settings. A fine-grained token must have repository Actions write permission.
GITHUB_ACTIONS_OWNER=swd-dev00
GITHUB_ACTIONS_REPO=Palm.ai
GITHUB_ACTIONS_WORKFLOW=palm-runner.yml
GITHUB_ACTIONS_REF=main
GITHUB_ACTIONS_DISPATCH_TOKEN=replace-with-a-fine-grained-github-token

# These Forge/Manus storage values are only required for the legacy cloud-upload adapter.
# The restored Oracle MVP does not provide an equivalent storage service yet.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# The original OAuth/session integration was absent from the archive and is NOT restored.
# Do not set PALM_DEV_OPEN_ID in production. A production auth adapter is required before user task APIs are enabled.
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
# VITE_APP_ID=
# PALM_DEV_OPEN_ID=
